+                JSONObject start=LibraryStore.startingPose(store.views(digest));
+                require(Math.abs(start.getJSONArray("position").getDouble(0)+10.0780735)<1e-8,"Launch position was lost");
+                require(Math.abs(start.getJSONArray("forward").getDouble(2)-0.82267284)<1e-8,"Launch direction was lost");
+                require(store.metadata(digest).getJSONObject("settings").getString("upAxis").equals("yDown"),"Up axis was lost");
+                store.editView(digest,viewId,"rename","My local view");
+                try(InputStream in=new FileInputStream(args[0]);ScanPackage p=ScanPackage.read(in,scans)){
+                    require(!store.importPackage(p,scans,true),"Repeated import added a duplicate");
+                }
+                require(scans.list().length==1,"Repeated import left extra files");
+                require(store.views(digest).getJSONArray("views").getJSONObject(0).getString("name").equals("My local view"),"Local View edit was overwritten");
+            }
+        }finally{
+            try(java.util.stream.Stream<Path> all=Files.walk(base)){
+                for(Path path:(Iterable<Path>)all.sorted(Comparator.reverseOrder())::iterator)Files.delete(path);
+            }
+        }
+        System.out.println("ScanPackageTests passed");
+    }
+}
